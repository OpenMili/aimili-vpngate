# 一台机器同时启动多个 AimiliVPN 实例时，每个实例用一份不同的 .env
# (或在不同目录下放各自的 .env) 避免端口/数据目录冲突。
#
# 用法（举例，假设要跑两个实例）：
#   mkdir -p ~/aimili-vpngate/instance-a ~/aimili-vpngate/instance-b
#   # 把 docker-compose.yml + 源码三件套放到各自目录，或用同一个 compose 文件
#   # instance-a 的 .env：
#     WEB_PORT=8787
#     PROXY_PORT=7928
#     DATA_DIR=./data
#   # instance-b 的 .env：
#     WEB_PORT=8788
#     PROXY_PORT=7929
#     DATA_DIR=./data
#   docker-compose --env-file .env up -d
#
# 留空则用默认值（8787 / 7928 / ./data），单实例行为与原来一致。

WEB_PORT=8787
PROXY_PORT=7928
DATA_DIR=./data